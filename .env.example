# Variáveis do backend (prefixo UANJI_). Em produção o Tauri define PORT, TOKEN e DATA_DIR.
# NÃO coloque segredos aqui: tokens de serviços externos vão para o Cofre (macOS Keychain).
UANJI_ENV=development
UANJI_HOST=127.0.0.1
UANJI_PORT=8765
UANJI_DATA_DIR=./.dev-data
UANJI_LOG_LEVEL=INFO
UANJI_SCHEDULER_ENABLED=true
UANJI_SCHEDULER_INTERVAL_SECONDS=60
# UANJI_TOKEN é gerado automaticamente por scripts/dev.sh (.dev-token) ou pelo Tauri.
